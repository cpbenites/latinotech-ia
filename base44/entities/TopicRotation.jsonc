{
  "name": "TopicRotation",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador fixo da rota\u00e7\u00e3o (sempre 'default')"
    },
    "last_theme": {
      "type": "string",
      "description": "\u00daltimo tema usado na rota\u00e7\u00e3o semanal"
    },
    "last_run": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima execu\u00e7\u00e3o do gerador"
    },
    "runs_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de execu\u00e7\u00f5es realizadas"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}