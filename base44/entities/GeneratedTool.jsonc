{
  "name": "GeneratedTool",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Identificador da URL, em kebab-case"
    },
    "kind": {
      "type": "string",
      "enum": [
        "calculator",
        "generator"
      ],
      "default": "calculator",
      "description": "calculator = campos num\u00e9ricos e f\u00f3rmulas; generator = produz resultado em um clique"
    },
    "title_pt": {
      "type": "string"
    },
    "title_es": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "subtitle_pt": {
      "type": "string"
    },
    "subtitle_es": {
      "type": "string"
    },
    "subtitle_en": {
      "type": "string"
    },
    "about_pt": {
      "type": "string"
    },
    "about_es": {
      "type": "string"
    },
    "about_en": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "description": "Calculadoras: campos num\u00e9ricos (key, label_pt/es/en, default, currency, suffix, hint_pt/es/en)",
      "items": {
        "type": "object"
      }
    },
    "outputs": {
      "type": "array",
      "description": "Calculadoras: resultados (key, label_pt/es/en, expr, format, accent)",
      "items": {
        "type": "object"
      }
    },
    "generator": {
      "type": "object",
      "description": "Geradores: type (password | numbers | template) e as op\u00e7\u00f5es do tipo"
    },
    "search_context": {
      "type": "string",
      "description": "Pesquisa de demanda usada na gera\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "slug",
    "title_pt"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}